{% extends 'base.html.twig' %}

{% block title %}Hello UserController!{% endblock %}

{% block body %}

    {% if events is not empty %}
        <a href="{{ path('app_user_other_profil', {
            username: events[0].organiser.username
        }) }}"
           class="btn btn-outline-dark px-4 py-2 rounded-pill fw-semibold m-3">

            <i class="fas fa-arrow-left me-2"></i>
            Retour
        </a>
    {% endif %}

    <div class="row row-cols-1 row-cols-md-3 g-4 p-5">

        {% for event in events %}

            {% set daysLeft = date(event.dateTimeStart).diff(date()).days %}
            {% set isPast = event.dateTimeStart < date() %}

            <div class="col">

                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="position-relative">

                        <img src="https://mdbcdn.b-cdn.net/img/new/standard/city/042.webp"
                             class="card-img-top"
                             style="height: 180px; object-fit: cover;"
                             alt="event image">

                        <span class="badge bg-primary position-absolute top-0 end-0 m-2 px-3 py-2 rounded-pill">
                            <i class="fas fa-school me-1"></i>
                            {{ event.site.name }}
                        </span>

                        <div class="position-absolute bottom-0 start-0 end-0 p-2 bg-dark bg-opacity-50 text-white">

                            <div class="d-flex justify-content-between align-items-center">

                                <div class="d-flex align-items-center gap-2">

                                    <img src="{{ event.organiser.img is not null
                                    ? asset('img/profil/' ~ event.organiser.img)
                                    : asset('img/avatar-random.png') }}"
                                         class="rounded-circle border border-white"
                                         width="32"
                                         height="32"
                                         alt="user avatar">

                                    <span class="fw-semibold small">
                                        {{ event.organiser.username }}
                                    </span>

                                </div>

                                {% if not isPast %}

                                    <span class="badge bg-primary-subtle text-primary border rounded-pill px-3 py-2">
                                        <i class="fas fa-hourglass-start me-1"></i>
                                        {{ daysLeft }} jour{% if daysLeft > 1 %}s{% endif %}
                                    </span>

                                {% else %}

                                    <span
                                        class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-2">
                                        <i class="fas fa-flag-checkered me-1"></i>
                                        Terminé
                                    </span>

                                {% endif %}

                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4">

                        <h5 class="fw-bold mb-2">
                            {{ event.title }}
                        </h5>

                        <div class="d-flex flex-wrap gap-2 mb-3">

                            <span class="badge bg-light text-dark border">
                                <i class="fas fa-users me-1"></i>
                                {{ event.nbParticipants }} participants
                            </span>

                            <span class="badge bg-light text-dark border">
                                <i class="fas fa-clock me-1"></i>
                                {{ event.duration|date('%h h %i') }}
                            </span>

                        </div>

                        <div class="text-muted small mb-3">
                            <i class="fas fa-hourglass-end me-1"></i>
                            Inscription jusqu’au {{ event.dateLimitRegistration|date('d/m/Y') }}
                        </div>

                        <a href="{{ path('app_event', {'id': event.id }) }}"
                           class="btn btn-primary rounded-3 fw-semibold w-100">

                            <i class="fas fa-eye me-1"></i>
                            Voir les détails

                        </a>

                    </div>

                </div>

            </div>

        {% endfor %}

        {% if totalPages > 1 %}
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-2 mt-4">

                {% if currentPage > 1 %}
                    <a href="{{ path('app_user_events_participated', { id: app.user.id, page: currentPage - 1 }) }}"
                       data-page="{{ currentPage - 1 }}"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        ← Précédent
                    </a>
                {% else %}
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>
                        ← Précédent
                    </button>
                {% endif %}

                {% for p in 1..totalPages %}

                    {% if p == 1
                        or p == totalPages
                        or (p >= currentPage - 2 and p <= currentPage + 2) %}

                        <a href="{{ path('app_user_events_participated', { id: app.user.id, page: p }) }}"
                           data-page="{{ p }}"
                           class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center {{ p == currentPage ? 'btn-primary' : 'btn-outline-primary' }}"
                           style="width: 34px; height: 34px;"
                           {% if p == currentPage %}aria-current="page"{% endif %}>
                            {{ p }}
                        </a>

                    {% endif %}

                {% endfor %}

                {% if currentPage < totalPages %}
                    <a href="{{ path('app_user_events_participated', { id: app.user.id, page: currentPage + 1 }) }}"
                       data-page="{{ currentPage + 1 }}"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Suivant →
                    </a>
                {% else %}
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>
                        Suivant →
                    </button>
                {% endif %}

            </div>
        {% endif %}


    </div>

{% endblock %}
