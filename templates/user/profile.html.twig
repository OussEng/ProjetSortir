{% extends 'base.html.twig' %}

{% block title %}Profil de {{ user.username }}{% endblock %}

{% block body %}

    {% set avatar = user is not null and user.getImg is not null
        ? asset('img/profil/' ~ user.getImg)
        : asset('img/avatar-random.png') %}

    <div class="container py-5">

        <div class="mx-auto" style="max-width: 1200px;">

            <div class="position-relative mb-5">

                <div class="rounded-4 overflow-hidden shadow-sm"
                     style="height: 320px;
                             background: linear-gradient(135deg, #0f172a, #1e293b);">

                    <div class="h-100 d-flex align-items-end p-5">

                        <div class="d-flex align-items-end gap-4">

                            <img src="{{ avatar }}"
                                 alt="Profil {{ user.username }}"
                                 class="rounded-circle border border-4 border-white shadow"
                                 style="width: 150px;
                                        height: 150px;
                                        object-fit: cover;">

                            <div class="text-white mb-3">

                                <h1 class="fw-bold mb-1">
                                    {{ user.username }}
                                </h1>

                                {% if user.firstname or user.lastname %}
                                    <p class="mb-2 text-white-50 fs-5">
                                        {{ user.firstname }} {{ user.lastname }}
                                    </p>
                                {% endif %}

                                <div class="d-flex flex-wrap gap-2">

                                    <span class="badge bg-light text-dark px-3 py-2 rounded-pill">
                                        <i class="fas fa-map-marker-alt me-1"></i>
                                        Paris, France
                                    </span>

                                    {% if user.isActive %}
                                        <span class="badge bg-primary px-3 py-2 rounded-pill">
                                            <i class="fas fa-star me-1"></i>
                                            Membre actif
                                        </span>
                                    {% else %}
                                        <span class="badge bg-secondary px-3 py-2 rounded-pill">
                                            <i class="fas fa-user-times me-1"></i>
                                            Membre inactif
                                        </span>
                                    {% endif %}


                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                {% if app.user == user %}

                    <div class="position-absolute top-0 end-0 m-4">

                        <a href="{{ path('app_user_edit') }}"
                           class="btn btn-light rounded-pill px-4 fw-semibold shadow-sm">

                            <i class="fas fa-pen me-2"></i>

                            Modifier le profil

                        </a>

                    </div>

                {% endif %}

            </div>

            <div class="row g-4 mb-5">

                <div class="col-md-6">

                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">

                        <div class="display-6 fw-bold text-primary mb-2">
                            {% if events %}
                                {{ events|length }}
                            {% else %}
                                0
                            {% endif %}
                        </div>

                        <div class="text-muted">
                            <i class="fas fa-calendar-plus me-1"></i>
                            Sorties créées
                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100">

                        <div class="display-6 fw-bold text-primary mb-2">
                            {% if userParticipate %}
                                {{ userParticipate|length }}
                            {% else %}
                                0
                            {% endif %}
                        </div>

                        <div class="text-muted">
                            <i class="fas fa-users me-1"></i>
                            Participations
                        </div>

                    </div>

                </div>

            </div>

            <div class="row g-4">

                <div class="col-lg-8">

                    {% if app.user == user %}

                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

                            <h4 class="fw-bold mb-4">
                                À propos
                            </h4>

                            <div class="row g-3">

                                {% if user.firstname or user.lastname %}

                                    <div class="col-md-6">

                                        <div class="bg-light rounded-4 p-3 h-100">

                                            <div class="text-muted small mb-1">
                                                <i class="fas fa-user me-1"></i>
                                                Nom complet
                                            </div>

                                            <div class="fw-semibold">
                                                {{ user.firstname }} {{ user.lastname }}
                                            </div>

                                        </div>

                                    </div>

                                {% endif %}

                                <div class="col-md-6">

                                    <div class="bg-light rounded-4 p-3 h-100">

                                        <div class="text-muted small mb-1">
                                            <i class="fas fa-envelope me-1"></i>
                                            Email
                                        </div>

                                        <div class="fw-semibold">
                                            {{ user.email }}
                                        </div>

                                    </div>

                                </div>

                                {% if user.phone %}

                                    <div class="col-md-6">

                                        <div class="bg-light rounded-4 p-3 h-100">

                                            <div class="text-muted small mb-1">
                                                <i class="fas fa-phone me-1"></i>
                                                Téléphone
                                            </div>

                                            <div class="fw-semibold">
                                                {{ user.phone }}
                                            </div>

                                        </div>

                                    </div>

                                {% endif %}

                            </div>

                        </div>

                    {% endif %}

                </div>



                <div class="col-lg-4">

                    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">

                        <h5 class="fw-bold mb-4">
                            Informations
                        </h5>

                        <div class="d-flex justify-content-between">

                            <span class="text-muted">
                                <i class="fas fa-fire me-1"></i>
                                Activité
                            </span>

                            {% if user.active == 1 %}

                                <span class="fw-semibold text-success">
                                    Actif
                                </span>

                            {% else %}

                                <span class="fw-semibold text-danger">
                                    Non actif
                                </span>

                            {% endif %}

                        </div>

                    </div>

                    <div class="card border-0 shadow-sm rounded-4 p-4">

                        <h5 class="fw-bold mb-4">
                            Actions rapides
                        </h5>

                        <div class="d-grid gap-3">

                            {% if app.user == user %}

                                <a href="{{ path('app_user_edit') }}"
                                   class="btn btn-primary rounded-pill fw-semibold">

                                    <i class="fas fa-user-pen me-1"></i>

                                    Modifier mon profil

                                </a>

                            {% endif %}

                            <a href="{{ path('app_events') }}"
                               class="btn btn-outline-primary rounded-pill fw-semibold">

                                <i class="fas fa-compass me-1"></i>

                                Explorer les sorties

                            </a>

                            <a href="{{ path('app_logout') }}"
                               class="btn btn-outline-danger rounded-pill fw-semibold">

                                <i class="fas fa-right-from-bracket me-1"></i>

                                Déconnexion

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <hr class="my-5">

        <div class="row g-4">

            <div class="col-lg-6">

                <div class="card border-0 shadow-sm rounded-4 p-4 h-100">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h5 class="fw-bold mb-0">
                            Sorties publiées
                        </h5>

                        <a href="{{ path('app_user_events', { id: user.id }) }}"
                           class="text-decoration-none fw-semibold text-primary small">
                            Voir toutes →
                        </a>

                    </div>

                    {% if events is not empty %}

                        <div class="d-grid gap-3">

                            {% for event in events|slice(0, 3) %}

                                <div class="p-3 rounded-4 border bg-light">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div class="me-3">

                                            <div class="fw-semibold">
                                                {{ event.title }}
                                            </div>

                                            <div class="text-muted small">
                                                Campus de {{ event.site.name }}
                                            </div>

                                            <div class="mt-2 d-flex gap-2 flex-wrap">

                                                <span class="badge bg-white text-dark border">
                                                    <i class="fas fa-users me-1"></i>
                                                    {{ event.participants|length }} participant{% if event.participants|length > 1 %}s{% endif %}
                                                </span>

                                                        <span class="badge bg-white text-dark border">
                                                    <i class="fas fa-location-dot me-1"></i>
                                                    {{ event.location.name }}
                                                </span>

                                            </div>

                                        </div>

                                        <a href="{{ path('app_event', {'id': event.id }) }}"
                                           class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="fas fa-eye me-1"></i>
                                            Ouvrir
                                        </a>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                    {% else %}

                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-calendar-xmark fa-2x mb-2"></i>
                            <div>Aucune sortie publiée</div>
                        </div>

                    {% endif %}

                </div>

            </div>

            <div class="col-lg-6">

                <div id="participations" class="card border-0 shadow-sm rounded-4 p-4 h-100">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h5 class="fw-bold mb-0">
                            Participations
                        </h5>

                        <a href="{{ path('app_user_events_participated', { id: user.id }) }}"
                           class="text-decoration-none fw-semibold text-primary small">
                            Voir toutes →
                        </a>

                    </div>

                    {% if userParticipate is not empty %}

                        <div class="d-grid gap-3">

                            {% for event in userParticipate|slice(0, 3) %}

                                {% set daysLeft = date(event.dateTimeStart).diff(date()).days %}
                                {% set isPast = event.dateTimeStart < date() %}

                                <div class="p-3 rounded-4 border bg-light">

                                    <div class="d-flex justify-content-between align-items-start">

                                        <div class="me-3">

                                            <div class="fw-semibold">
                                                {{ event.title }}
                                            </div>

                                            <div class="text-muted small">
                                                Campus de {{ event.site.name }}
                                            </div>

                                            <div class="mt-2 d-flex gap-2 flex-wrap">

                                                <span class="badge bg-white text-dark border">
                                                    <i class="fas fa-users me-1"></i>
                                                    {{ event.participants|length }} participant{% if event.participants|length > 1 %}s{% endif %}
                                                </span>

                                                <span class="badge bg-white text-dark border">
                                                    <i class="fas fa-location-dot me-1"></i>
                                                    {{ event.location.name }}
                                                </span>

                                                {% if not isPast %}

                                                    <span class="badge bg-primary-subtle text-primary border">
                                                        <i class="fas fa-hourglass-start me-1"></i>
                                                        Débute dans {{ daysLeft }} jour{% if daysLeft > 1 %}s{% endif %}
                                                    </span>

                                                {% else %}

                                                    <span class="badge bg-secondary-subtle text-secondary border">
                                                        <i class="fas fa-flag-checkered me-1"></i>
                                                        Terminé
                                                    </span>

                                                {% endif %}

                                            </div>

                                        </div>

                                        <a href="{{ path('app_event', {'id': event.id }) }}"
                                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            <i class="fas fa-eye me-1"></i>
                                            Ouvrir
                                        </a>

                                    </div>

                                </div>

                            {% endfor %}

                        </div>

                    {% else %}

                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-user-slash fa-2x mb-2"></i>
                            <div>Aucune participation</div>
                        </div>

                    {% endif %}

                </div>

            </div>

        </div>

    </div>

{% endblock %}
