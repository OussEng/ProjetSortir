{% extends 'base.html.twig' %}

{% block title %}Modifier le mot de passe{% endblock %}

{% block body %}

    <div class="container py-5">
        <div class="position-relative mb-5">
            <div class="rounded-4 overflow-hidden shadow-sm"
                 style="height: 180px; background: linear-gradient(135deg, #111827, #1f2937);">

                <div class="h-100 d-flex align-items-end p-4">
                    <div class="text-white">
                        <h2 class="fw-bold mb-1">
                            <i class="fas fa-lock me-2"></i>
                            Sécurité du compte
                        </h2>
                        <p class="text-white-50 mb-0">
                            Changez votre mot de passe pour sécuriser votre compte
                        </p>
                    </div>
                </div>
            </div>

            <div class="position-absolute top-0 end-0 m-3">
                <a href="{{ path('app_user_edit') }}"
                   class="btn btn-light rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="fas fa-arrow-left me-2"></i>
                    Retour
                </a>
            </div>
        </div>

        <!-- FORM -->
        <div class="row justify-content-center">
            <div class="col-lg-6">

                <div class="bg-white border rounded-4 shadow-sm p-4">

                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-shield-halved me-2 text-primary"></i>
                        Modifier le mot de passe
                    </h5>

                    <div class="alert alert-warning rounded-4">
                        <i class="fas fa-triangle-exclamation me-2"></i>
                        Choisissez un mot de passe fort et unique.
                    </div>

                    {{ form_start(editPasswordForm) }}

                    <div class="mb-3">
                        {{ form_row(editPasswordForm.currentPassword) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(editPasswordForm.newPassword) }}
                    </div>

                    <div class="d-flex gap-3 mt-4">

                        <button type="submit"
                                class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="fas fa-check me-2"></i>
                            Mettre à jour
                        </button>

                        <a href="{{ path('app_user_edit') }}"
                           class="btn btn-outline-dark rounded-pill px-4 fw-semibold">
                            Annuler
                        </a>

                    </div>

                    {{ form_end(editPasswordForm) }}

                </div>
            </div>
        </div>
    </div>

{% endblock %}
