{% extends 'base.html.twig' %}

{% block title %}Accès refusé -403 {% endblock %}

{% block body %}
    <div class="container py-5 text-center">
        <div class="row justify-content-center my-5">
            <div class="col-md-6">
                <div class="text-primary display-1 fw-bold mb-3">
                    <i class="fa-solid fa-user-shield"></i> 403
                </div>

                <h1 class="fw-bold h2 mb-3">Accès Interdit</h1>

                <p class="text-muted lead mb-4">
                    Désolé, vous n'avez pas les autorisations nécessaires pour accéder à cette page.
                    Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur.
                </p>

                <a href="{{ path('app_events') }}" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                    <i class="fa-solid fa-house me-2"></i> Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}
