{% extends 'base.html.twig' %}

{% block title %}Erreur de l'application{% endblock %}

{% block body %}
    <div class="container py-5 text-center">
        <div class="row justify-content-center my-5">
            <div class="col-md-6">

                <div class="text-primary display-1 fw-bold mb-3">
                    <i class="fa-solid fa-triangle-exclamation text-primary mb-2"></i><br>
                    {{ status_code is defined ? status_code : 'Oups' }}
                </div>

                <h1 class="fw-bold h2 mb-3 text-dark">
                    What the hell !
                </h1>

                <p class="text-muted lead mb-4">
                    Une erreur inattendue est survenue sur l'application.
                </p>

                <a href="{{ path('app_events') }}" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold shadow-sm">
                    <i class="fa-solid fa-house me-2"></i> Retour à l'accueil
                </a>

            </div>
        </div>
    </div>
{% endblock %}
