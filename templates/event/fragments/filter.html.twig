{% block filter %}
    <div class="card shadow-sm border-0 rounded-4 p-3 mb-4 bg-light">
        <form method="get" id="filter-form" class="row g-3 align-items-end">

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-muted">
                    <i class="fas fa-search me-1"></i> Rechercher un événement
                </label>

                <input type="text"
                       name="search"
                       id="search-input"
                       class="form-control rounded-pill"
                       placeholder="Nom..."
                       value="{{ app.request.query.get('search') }}">
            </div>

            <div class="col-12 col-sm-6 col-md-3">
                <label class="form-label fw-semibold small text-muted">
                    <i class="fas fa-location-dot me-1"></i> Filtrer par site
                </label>

                <select name="site"
                        id="site-select"
                        class="form-select rounded-pill">

                    <option value="">Tous les sites</option>

                    {% for site in sites %}
                        <option value="{{ site.id }}"
                            {% if app.request.query.get('site') == site.id %}
                        selected
                            {% endif %}>
                            {{ site.name }}
                        </option>
                    {% endfor %}

                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold small text-muted">
                    <i class="fas fa-calendar me-1"></i> Période
                </label>

                <div class="d-flex gap-2">

                    <input type="date"
                           name="dateFrom"
                           id="date-from"
                           class="form-control form-control-sm rounded-pill"
                           value="{{ app.request.query.get('dateFrom') }}">

                    <input type="date"
                           name="dateTo"
                           id="date-to"
                           class="form-control form-control-sm rounded-pill"
                           value="{{ app.request.query.get('dateTo') }}">

                </div>
            </div>

            <div class="col-12 col-md-3">

                <label class="form-label fw-semibold small text-muted">
                    Filtres rapides
                </label>

                <div class="d-flex flex-column gap-1">

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="includePast"
                               id="include-past"
                               value="1"
                            {% if app.request.query.get('includePast') %}
                                checked
                            {% endif %}>

                        <label class="form-check-label small" for="include-past">
                            Voir les sorties passées
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="myEvents"
                               id="my-events"
                               value="1"
                            {% if app.request.query.get('myEvents') %}
                                checked
                            {% endif %}>

                        <label class="form-check-label small" for="my-events">
                            Mes inscriptions
                        </label>
                    </div>

                </div>
            </div>

            <div class="col-12">
                <div class="d-flex gap-2 justify-content-end">

                    <button type="submit"
                            id="search-button"
                            class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold">
                        <i class="fas fa-magnifying-glass me-1"></i>
                        Rechercher
                    </button>

                    <a href="{{ path('app_events') }}"
                       class="btn btn-outline-secondary btn-sm rounded-pill px-4">
                        <i class="fas fa-rotate-left me-1"></i>
                        Reset
                    </a>

                </div>
            </div>

        </form>
    </div>
{% endblock %}
