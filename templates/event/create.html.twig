{% extends 'base.html.twig' %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-12 col-md-9 col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="bg-primary text-white p-4">

                        <div class="d-flex align-items-center gap-3">

                            <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 65px; height: 65px;">

                                <i class="fas fa-mountain-sun fa-2x"></i>

                            </div>

                            <div>

                                <h2 class="fw-bold mb-1">
                                    Créer une sortie
                                </h2>

                                <p class="mb-0 text-white-50">
                                    Organisez votre prochaine aventure
                                </p>

                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4 p-md-5 bg-light">

                        {{ form_start(eventForm) }}

                        <div class="mb-4">

                            {{ form_widget(eventForm) }}

                        </div>

                        <div class="d-grid">

                            <button class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm">

                                <i class="fas fa-plus-circle me-2"></i>
                                Créer la sortie

                            </button>

                        </div>

                        {{ form_end(eventForm) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

    <script>

        document.addEventListener('DOMContentLoaded', function () {

            let today = new Date().toISOString().split('T')[0] + "T00:00";

            let dateHeureDebut = document.getElementById('event_dateTimeStart');

            let dateLimiteInscription = document.getElementById('event_dateLimitRegistration');

            if (dateHeureDebut && dateLimiteInscription) {

                dateHeureDebut.setAttribute('min', today);

                dateLimiteInscription.setAttribute('min', today);

            }

        });

    </script>

{% endblock %}
