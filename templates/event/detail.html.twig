{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}

    <div class="container py-5">

        <a href="{{ path('app_events') }}"
           class="btn btn-outline-dark px-4 py-2 rounded-pill fw-semibold mb-4">
            ← Retour
        </a>

        <div class="position-relative mb-4">
            <img src="https://mdbcdn.b-cdn.net/img/new/standard/city/042.webp"
                 class="w-100 rounded-4 shadow-sm"
                 style="height: 420px; object-fit: cover;"
                 alt="event image">

            <div class="position-absolute top-0 start-0 m-4
                    d-flex align-items-center gap-2
                    bg-dark bg-opacity-50 text-white
                    px-3 py-2 rounded-pill">

                <a href="{{ path('app_user_other_profil' , { username : event.organiser.username}) }}" class="text-decoration-none text-white">
                    <img src="{{ event.organiser.img is not null ? event.organiser.img : asset('img/profil/avatar-random.png') }}"
                         class="rounded-circle border border-white"
                         width="40"
                         height="40"
                         alt="user avatar">

                    <span class="fw-semibold">
                        {{ event.organiser.username }}
                    </span>
                </a>
            </div>

            <div class="position-absolute bottom-0 end-0 m-4">
            <span class="badge bg-primary px-4 py-3 rounded-pill fs-6 shadow">
                📅 {{ event.dateTimeStart|date('d/m/Y H:i') }}
            </span>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-3">
                    {{ event.title }}
                </h1>

                <p class="lead text-muted mb-4">
                    {{ event.eventDescription }}
                </p>

                <hr>

                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="text-muted small mb-1">
                                📍 Lieu
                            </div>
                            <div class="fw-semibold">
                                {{ event.location.name }}
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="text-muted small mb-1">
                                🏫 Campus
                            </div>

                            <div class="fw-semibold">
                                {{ event.site.name }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border">

                    <h5 class="fw-bold mb-4">
                        Informations
                    </h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">👥 Participants</span>
                        <span class="fw-semibold">
                        {{ event.nbParticipants }}
                    </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">⏱ Durée</span>
                        <span class="fw-semibold">
                        {{ event.duration|date('%h h %i') }}
                    </span>
                    </div>

                    <div class="d-flex justify-content-between mb-4">
                        <span class="text-muted">📝 Date de fin d'nscription</span>
                        <span class="fw-semibold">
                        {{ event.dateLimitRegistration|date('d/m/Y') }}
                    </span>
                    </div>

                    <button class="btn btn-primary w-100 py-3 rounded-3 fw-semibold">
                        Participer à l'événement
                    </button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
