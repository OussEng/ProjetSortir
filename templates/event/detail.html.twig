{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="d-flex gap-2 mb-4">
            <a href="{{ path('app_events') }}"
               class="btn btn-outline-primary px-4 py-2 rounded-pill fw-semibold">
                ← Retour
            </a>

            <a href="{{ path('app_event_update', {'id': event.id }) }}"
               class="btn btn-warning px-4 py-2 rounded-pill fw-semibold">
                <i class="fas fa-pen me-1"></i>
                Modifier
            </a>
        </div>

        <div class="position-relative mb-4">
            <img src="https://mdbcdn.b-cdn.net/img/new/standard/city/042.webp"
                 class="w-100 rounded-4 shadow-sm"
                 style="height: 420px; object-fit: cover;"
                 alt="event image">

            <div class="position-absolute top-0 start-0 m-4
                    d-flex align-items-center gap-2
                    bg-dark bg-opacity-50 text-white
                    px-3 py-2 rounded-pill">

                <a href="{{ path('app_user_other_profil' , { username : event.organiser.username}) }}" class="text-decoration-none text-white">
                    <img src="{{ event.organiser.img is not null ? asset('img/profil/' ~ event.organiser.img) : asset('img/avatar-random.png')  }}"
                         class="rounded-circle border border-white"
                         width="40"
                         height="40"
                         alt="user avatar">

                    <span class="fw-semibold">
                        {{ event.organiser.username }}
                    </span>
                </a>
            </div>

            <div class="position-absolute bottom-0 end-0 m-4">
                <span class="badge bg-primary px-4 py-3 rounded-pill fs-6 shadow">
                    <i class="fas fa-calendar-alt me-2"></i>
                    {{ event.dateTimeStart|date('d/m/Y H:i') }}
                </span>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-8">
                <h1 class="fw-bold mb-3">
                    {{ event.title }}
                </h1>
                {% if event.isCancelled()  %}
                    <h4 class="text-danger">Motif d'annulation :</h4>
                {% endif %}

                <p class="lead text-muted mb-4">
                    {{ event.eventDescription  }}
                </p>

            </div>

            <div class="col-lg-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border">

                    <h5 class="fw-bold mb-4">
                        Informations
                    </h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                            <i class="fas fa-users me-1"></i> Participants maximum
                        </span>
                        <span class="fw-semibold">
                            {{ event.nbParticipants }}
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">
                             <i class="fas fa-school me-1"></i> Campus
                        </span>
                        <span class="fw-semibold">
                            {{ event.site.name }}
                        </span>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">
                                <i class="fas fa-clock me-1"></i> Durée
                            </span>
                            <span class="fw-semibold">
                                {{ event.duration|date('%h h %i') }}
                            </span>
                        </div>

                        <div class="d-flex flex-column gap-3 mt-4">

                            {% if app.user not in event.participants and event.isOpen() %}
                                <a href="{{ path('app_participate', {'id': event.id}) }}"
                                   class="btn btn-primary rounded-3 fw-semibold py-2 w-100 text-center">
                                    <i class="fas fa-user-plus me-2"></i> Participer
                                </a>
                            {% endif %}

                            {% if app.user in event.participants and event.isOpen() %}
                                <a href="{{ path('app_quit', {'id': event.id}) }}"

                                   class="btn btn-outline-dark rounded-3 fw-semibold py-2 w-100 text-center">

                                    <i class="fas fa-user-minus me-2"></i> Se désister
                                </a>
                            {% endif %}


                            {% if (app.user === event.organiser or is_granted('ROLE_ADMIN')) and event.isOpen() %}
                                <a href="{{ path('app_reason', {'id': event.id}) }}"
                                   class="btn btn-danger btn-sm rounded-3 fw-semibold py-2 w-100 text-center">
                                    Annuler
                                </a>
                            {% endif %}

                            {% if event.isCancelled() %}
                                <div class="alert alert-warning text-center mb-0" role="alert">
                                    <i class="fas fa-exclamation-triangle me-2"></i> Cette sortie a été annulée.
                                </div>
                            {% endif %}

                            {% if event.isCreated() and event.organiser == app.user %}
                                <a href="{{ path('app_publish', {'id': event.id}) }}"
                                   class="btn btn-success btn-sm rounded-3 fw-semibold py-2 w-100 text-center">
                                    Publiée
                                </a>
                            {% endif %}

                        </div>
                    </div>
                </div>

                <div class="p-4 bg-light rounded-4 border-0 mt-4 shadow-sm">
                    <div class="text-muted small mb-2">
                        <i class="fa-solid fa-map-location-dot me-1"></i> Lieu du rendez-vous
                    </div>
                    <address class="fw-semibold lh-base mb-0">
                        <span class="text-primary fs-5"><i class="fa-solid fa-location-dot me-2"></i>{{ event.location.name }}</span><br>
                        <span class="text-muted small">{{ event.location.address }}</span><br>
                        {{ event.location.city.zipcode }} {{ event.location.city.name }}
                    </address>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <div class="bg-white shadow-sm rounded-4 p-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Participants</h5>
                        <span class="badge bg-light text-dark border">
                            {{ event.participants|length }} inscrit(s)
                        </span>
                    </div>

                    {% if event.participants is not empty %}
                        <div class="row row-cols-1 row-cols-md-3 g-3">
                            {% for participant in event.participants %}
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 bg-light">
                                        <div class="card-body d-flex align-items-center gap-3">
                                            <img
                                                src="{{ participant.img is not null ? asset('img/profil/' ~ participant.img) : asset('img/profil/avatar-random.png')  }}"
                                                class="rounded-circle border"
                                                width="56"
                                                height="56"
                                                alt="avatar {{ participant.username }}"
                                                style="object-fit: cover;"
                                            >

                                            <div class="flex-grow-1">
                                                <a href="{{ path('app_user_other_profil', { username: participant.username }) }}"
                                                   class="text-decoration-none fw-semibold text-dark d-block">
                                                    {{ participant.firstname }} {{ participant.lastname|upper }}
                                                </a>
                                                <small class="text-muted">@{{ participant.username }}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-light border mb-0 rounded-4 text-center py-4 text-muted">
                            <i class="fa-regular fa-face-frown fs-4 mb-2 d-block"></i> Aucun participant inscrit pour le moment
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

{% endblock %}
