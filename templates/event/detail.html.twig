{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}

    <div class="container py-5">

        <a href="{{ path('app_events') }}"
           class="btn btn-outline-dark px-4 py-2 rounded-pill fw-semibold mb-4">
            ← Retour
        </a>

        <div class="position-relative mb-4">

            <img src="https://mdbcdn.b-cdn.net/img/new/standard/city/042.webp"
                 class="w-100 rounded-4 shadow-sm"
                 style="height: 420px; object-fit: cover;"
                 alt="event image">

            <div class="position-absolute top-0 start-0 m-4
                    d-flex align-items-center gap-2
                    bg-dark bg-opacity-50 text-white
                    px-3 py-2 rounded-pill">

                <a href="{{ path('app_user_other_profil' , { username : event.organiser.username}) }}" class="text-decoration-none text-white">
                    <img src="{{ event.organiser.img is not null ? event.organiser.img : 'https://i.pravatar.cc/40?img=3' }}"
                         class="rounded-circle border border-white"
                         width="40"
                         height="40"
                         alt="user avatar">

                    <span class="fw-semibold">
                        {{ event.organiser.username }}
                    </span>
                </a>
            </div>

            <div class="position-absolute bottom-0 end-0 m-4">
            <span class="badge bg-primary px-4 py-3 rounded-pill fs-6 shadow">
                📅 {{ event.dateTimeStart|date('d/m/Y H:i') }}
            </span>
            </div>

        </div>

        <div class="row g-5">

            <div class="col-lg-8">

                <h1 class="fw-bold mb-3">
                    {{ event.title }}
                </h1>

                <p class="lead text-muted mb-4">
                    {{ event.eventDescription }}
                </p>

                <hr>

                <div class="row g-3 mt-2">

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="text-muted small mb-1">
                                📍 Lieu
                            </div>

                            <div class="fw-semibold">
                                {{ event.location.name }}
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-4">
                            <div class="text-muted small mb-1">
                                🏫 Campus
                            </div>

                            <div class="fw-semibold">
                                {{ event.site.name }}
                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="bg-white shadow-sm rounded-4 p-4 border">

                    <h5 class="fw-bold mb-4">
                        Informations
                    </h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">👥 Participants maximum</span>
                        <span class="fw-semibold">
                        {{ event.nbParticipants }}
                    </span>
                    </div>
{% dump(event.participants) %}
                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">⏱ Durée</span>
                            <span class="fw-semibold">
            {{ event.duration|date('%h h %i') }}
        </span>
                        </div>

                        {% if app.user not in event.participants %}
                            <div class="d-flex flex-column gap-2">
                                <a href="{{ path('app_participate', {'id': event.id}) }}"
                                   class="btn btn-primary btn-sm rounded-3 fw-semibold py-2">
                                    Participer
                                </a>
                            </div>
                        {% endif %}

                        {% if app.user in event.participants %}
                        <div class="d-flex flex-column gap-2">
                            <a href="{{ path('app_quit', {'id': event.id}) }}"
                               class="btn btn-light border btn-sm rounded-3 fw-semibold py-2">
                                Se désister
                            </a>
                        </div>
                        {% endif %}


                    </div>

                </div>

            </div>

            <div class="col-12 mt-4">
                <div class="bg-white shadow-sm rounded-4 p-4 border">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Participants</h5>
                        <span class="badge bg-light text-dark border">
                {{ event.participants|length }} inscrit(s)
            </span>
                    </div>

                    {% if event.participants is not empty %}
                        <div class="row row-cols-1 row-cols-md-3 g-3">
                            {% for participant in event.participants %}
                                <div class="col">
                                    <div class="card h-100 border-0 shadow-sm rounded-4">
                                        <div class="card-body d-flex align-items-center gap-3">
                                            <img
                                                src="{{ participant.img is not null ? asset('img/profil/' ~ participant.img) : asset('img/profil/avatar-random.png')  }}"
                                                class="rounded-circle border"
                                                width="56"
                                                height="56"
                                                alt="avatar {{ participant.username }}"
                                                style="object-fit: cover;"
                                            >

                                            <div class="flex-grow-1">
                                                <a href="{{ path('app_user_other_profil', { username: participant.username }) }}"
                                                   class="text-decoration-none fw-semibold text-dark d-block">
                                                    {{ participant.firstname }} {{ participant.lastname|upper }}
                                                </a>
                                                <small class="text-muted">@{{ participant.username }}</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-light border mb-0 rounded-4">
                            Aucun participant inscrit
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

    </div>

{% endblock %}
