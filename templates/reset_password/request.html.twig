{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h1 class="h4 mt-2 mb-0">Mot de passe oublié ?</h1>
                        </div>

                        {% for flash_error in app.flashes('reset_password_error') %}
                            <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                                <span>{{ flash_error }}</span>
                            </div>
                        {% endfor %}

                        <p class="text-muted text-center mb-4">
                            Saisissez votre adresse email ci-dessous et nous vous enverrons un lien pour réinitialiser votre mot de passe.
                        </p>

                        {{ form_start(requestForm, {'attr': {'novalidate': 'novalidate'}}) }}
                        {{ form_row(requestForm.email, {
                            'label': 'Adresse email',
                            'attr': {'placeholder': 'exemple@email.com', 'class': 'form-control'}
                        }) }}

                        <div class="d-grid mt-4">
                            <button class="btn btn-primary rounded-3">
                                Envoyer le lien de réinitialisation
                            </button>
                        </div>
                        {{ form_end(requestForm) }}

                        <div class="text-center mt-3">
                            <a href="{{ path('app_login') }}" class="text-muted small text-decoration-none">
                                Retour à la connexion
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
{% endblock %}
