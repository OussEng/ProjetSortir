{% extends 'base.html.twig' %}

{% block title %}Liste des Groupes{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="card bg-light-subtle">
        <div class="card-body">
            <div class="d-flex justify-content-center mb-4">
                {% if app.user %}
                <h1 class="mb-0 position-relative">
                    Bonjour {{ app.user.username }}</h1>
                {% endif %}
            </div>
            <hr style="width: 100%; height: 3px; background: #96CEB4; border-radius: 3px;">
            <br>
            <h2 class="text-center m-3">Mes Groupes Privés</h2>

            <div class="d-flex justify-content-center mt-3">
                <a href="{{ path('app_groupe_creer') }}" class="btn btn-info justify-content-center w-30">
                    Créer un Groupe</a>
            </div>

            {% if groupes|length == 0 %}
            <div class="text-center m-3">
                <p>Vous n'avez aucun groupe privé</p>
                <p>Cliquez sur le lien pour créer un groupe privé</p>
                <div class="d-flex justify-content-center mt-3">
                    <a href="{{ path('app_groupe_creer') }}" class="btn btn-info justify-content-center w-30">
                        Créer un Groupe</a>
                </div>
            </div>
            {% endif %}

            {% for groupe in groupes %}
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h3>Groupe : {{ groupe.name }}</h3>
                    <div>
                        <a class="btn bg-success fw-semibold text-white" href="{{ path('app_groupe_modifier',{'id':groupe.id}) }}">
                            Modifier</a>
                        <a class="btn bg-danger fw-semibold text-white" href="{{ path('app_groupe_supprimer',{'id':groupe.id}) }}">
                            Supprimer</a>
                    </div>
                </div>
                <table class="table">
                    <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Pseudo</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Prenom</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for key, membre in groupe.members %}
                    <tr>
                        <th>{{ key+1 }}</th>
                        <th scope="row">{{ membre.username }}</th>
                        <td>{{ membre.lastname }}</td>
                        <td>{{ membre.firstname }}</td>
                    </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
