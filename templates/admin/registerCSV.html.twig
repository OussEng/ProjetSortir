{% extends 'base.html.twig' %}

{% block title %}Backoffice Admin{% endblock %}

{% block body %}
    <div class="card-body">
        <div class="d-flex justify-content-center mb-4">
            <h1 class="mb-0 position-relative" style="color: #444; padding-bottom: 12px;">
                Upload de fichier
                <span class="position-absolute" style="bottom: 0; left: 50%; transform: translateX(-50%); width: 100px; height: 3px; background: #0DCAF0; border-radius: 3px;"></span>
            </h1>
        </div>
        <br>

        <div class="row justify-content-center">
            <div class="col-md-8">
                {% if error is defined and error %}
                    <div class="alert alert-danger text-center">
                        {{ error }}
                    </div>
                {% endif %}

                {% if success is defined and success %}
                    <div class="alert alert-success text-center">
                        {{ success }}
                    </div>
                {% endif %}

                {{ form_start(form) }}
                <div class="mb-3">
                    {{ form_widget(form) }}
                </div>

                <div class="d-flex justify-content-center mt-4">
                    <button type="submit" class="btn btn-info justify-content-center w-50">
                        Enregistrer
                    </button>
                </div>
                {{ form_end(form) }}

            </div>
        </div>
    </div>


{% endblock %}
