{% extends 'base.html.twig' %}

{% block title %}Admin | Utilisateurs{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold text-dark mb-1">
                    <i class="fa-solid fa-users-gear text-primary me-2"></i>Gestion des utilisateurs
                </h1>
                <p class="text-muted mb-0">Activez, supprimez ou modifiez les droits des membres de la plateforme.</p>
            </div>
            <span class="badge bg-light text-secondary border px-3 py-2 fs-6 rounded-pill">
                <span class="text-dark fw-bold">{{ allUsers|length }}</span> membres enregistrés
            </span>
        </div>

        <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-muted text-uppercase small fw-bold">Utilisateur</th>
                        <th class="py-3 text-muted text-uppercase small fw-bold">Rôle actuel</th>
                        <th class="py-3 text-muted text-uppercase small fw-bold">Statut</th>
                        <th class="pe-4 py-3 text-muted text-uppercase small fw-bold text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr {% if user == app.user %}class="table-light"{% endif %}>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <img
                                        src="{{ user.img is not null ? asset('img/profil/' ~ user.img) : asset('img/profil/avatar-random.png') }}"
                                        class="rounded-circle border"
                                        width="48"
                                        height="48"
                                        alt="avatar {{ user.username }}"
                                        style="object-fit: cover;">
                                    <div>
                                        <div class="fw-semibold text-dark">
                                            {{ user.firstname is defined ? user.firstname : '' }} {{ user.lastname is defined ? user.lastname|upper : '' }}
                                            {% if user == app.user %}
                                                <span
                                                    class="badge bg-secondary-subtle text-secondary border rounded-pill ms-1 px-2 py-0 small"
                                                    style="font-size: 0.75rem;">Vous</span>
                                            {% endif %}
                                        </div>
                                        <small
                                            class="text-muted">@{{ user.username }} {% if user.email is defined %}· {{ user.email }}{% endif %}</small>
                                    </div>
                                </div>
                            </td>

                            <td class="py-3">
                                {% if user.roles is defined and 'ROLE_ADMIN' in user.roles %}
                                    <span class="badge bg-primary rounded-pill px-3 py-2 small">
                                        <i class="fa-solid fa-user-shield me-1"></i> Administrateur
                                    </span>
                                {% else %}
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-2 small">
                                        <i class="fa-solid fa-user me-1"></i> Participant
                                    </span>
                                {% endif %}
                            </td>
                            <td class="py-3">
                                {% if user.active %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-circle-check me-1"></i> Actif
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">
                                        <i class="fa-solid fa-circle-xmark me-1"></i> Inactif
                                    </span>
                                {% endif %}
                            </td>

                            <td class="pe-4 py-3 text-end">
                                {% if user != app.user %}
                                    <div class="d-inline-flex gap-2">
                                        {% if user.active %}
                                            <a href="{{ path('app_admin_desactivate_status', { 'id': user.id }) }}"
                                               class="btn btn-outline-warning btn-sm rounded-3 fw-semibold"
                                               title="Désactiver le compte">
                                                <i class="fa-solid fa-ban me-1"></i> Désactiver
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_admin_actived_status', { 'id': user.id }) }}"
                                               class="btn btn-outline-success btn-sm rounded-3 fw-semibold"
                                               title="Activer le compte">
                                                <i class="fa-solid fa-circle-check me-1"></i> Activer
                                            </a>
                                        {% endif %}

                                        <a href="{{ path('app_admin_delete_user', { 'id' : user.id }) }}"
                                           class="btn btn-outline-danger btn-sm rounded-3 fw-semibold"
                                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer définitivement @{{ user.username }} ?');">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </a>
                                    </div>
                                {% else %}
                                    <span class="text-muted small fst-italic">Non modifiable</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-users-slash fs-3 mb-2 d-block text-secondary"></i>
                                Aucun utilisateur trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {% if totalPages is defined and totalPages > 1 %}
            <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-4">
                {% if currentPage > 1 %}
                    <a href="{{ path('app_admin_users', { page: currentPage - 1 }) }}"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        <i class="fas fa-chevron-left me-1"></i> Précédent
                    </a>
                {% else %}
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>
                        <i class="fas fa-chevron-left me-1"></i> Précédent
                    </button>
                {% endif %}

                Liste des pages
                {% for p in 1..totalPages %}
                    {% if p == 2 and currentPage > 4 %}
                        <span class="text-muted px-1">…</span>
                    {% endif %}

                    {% if p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}
                        <a href="{{ path('app_admin_users', { page: p }) }}"
                           class="btn btn-sm rounded-circle d-inline-flex align-items-center justify-content-center {{ p == currentPage ? 'btn-primary' : 'btn-outline-primary' }}"
                           style="width: 32px; height: 32px;"
                           {% if p == currentPage %}aria-current="page"{% endif %}>
                            {{ p }}
                        </a>
                    {% endif %}

                    {% if p == totalPages - 1 and currentPage < totalPages - 3 %}
                        <span class="text-muted px-1">…</span>
                    {% endif %}
                {% endfor %}

                {% if currentPage < totalPages %}

                    <a href="{{ path('app_admin_users', { page: currentPage + 1 }) }}"
                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Suivant <i class="fas fa-chevron-right ms-1"></i>
                    </a>

                {% else %}

                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" disabled>
                        Suivant <i class="fas fa-chevron-right ms-1"></i>
                    </button>

                {% endif %}
            </div>
        {% endif %}

    </div>
{% endblock %}
