{% extends 'base.html.twig' %}

{% block title %}Liste des villes{% endblock %}

{% block body %}

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-3">
                <i class="fas fa-location-dot me-2 text-primary"></i>
                Villes
            </h3>

            <div class="d-flex gap-2">

                <a href="{{ path('app_location_create') }}"
                   class="btn btn-outline-primary rounded-pill fw-semibold">

                    <i class="fas fa-plus me-2"></i>
                    Ajouter un lieu

                </a>

                <a href="{{ path('app_city_create') }}"
                   class="btn btn-outline-success rounded-pill fw-semibold">

                    <i class="fas fa-city me-2"></i>
                    Ajouter une ville

                </a>

            </div>
        </div>

        {% if city is empty %}

            <div class="text-center py-5 text-muted">

                <i class="fas fa-city fa-3x mb-3"></i>

                <p class="mb-0">
                    Aucune ville trouvée
                </p>

            </div>

        {% else %}

            <div class="row row-cols-1 row-cols-md-3 g-4">

                {% for city in city %}

                    <div class="col">

                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                            <div class="bg-primary p-3 position-relative">

                                <span
                                    class="badge bg-white bg-opacity-25 text-white position-absolute top-0 end-0 m-2 px-3 py-2 rounded-pill">

                                    <i class="fas fa-mail-bulk me-1"></i>

                                    {{ city.zipcode }}

                                </span>

                                <div
                                    class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center justify-content-center"
                                    style="width: 44px; height: 44px;">

                                    <i class="fas fa-city text-white fs-5"></i>

                                </div>

                            </div>

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-3">

                                    {{ city.name }}

                                </h5>

                                <div class="d-flex align-items-center gap-2 text-muted small">

                                    <i class="fas fa-location-dot text-primary"></i>

                                    Code postal : {{ city.zipcode }}

                                </div>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            </div>

            {% if totalPages > 1 %}

                <div class="d-flex flex-wrap align-items-center gap-2 mt-4">

                    {% if currentPage > 1 %}

                        <a href="{{ path('app_city_list', { page: currentPage - 1 }) }}"
                           class="btn btn-outline-secondary btn-sm rounded-3">

                            <i class="fas fa-chevron-left me-1"></i>

                            Précédent

                        </a>

                    {% else %}

                        <button class="btn btn-outline-secondary btn-sm rounded-3" disabled>

                            <i class="fas fa-chevron-left me-1"></i>

                            Précédent

                        </button>

                    {% endif %}

                    {% for p in 1..totalPages %}

                        {% if p == 2 and currentPage > 4 %}
                            <span class="text-muted">…</span>
                        {% endif %}

                        {% if p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}

                            <a href="{{ path('app_city_list', { page: p }) }}"
                               class="btn btn-sm rounded-3 {{ p == currentPage ? 'btn-primary' : 'btn-outline-secondary' }}">

                                {{ p }}

                            </a>

                        {% endif %}

                        {% if p == totalPages - 1 and currentPage < totalPages - 3 %}
                            <span class="text-muted">…</span>
                        {% endif %}

                    {% endfor %}

                    {% if currentPage < totalPages %}

                        <a href="{{ path('app_city_list', { page: currentPage + 1 }) }}"
                           class="btn btn-outline-secondary btn-sm rounded-3">

                            Suivant

                            <i class="fas fa-chevron-right ms-1"></i>

                        </a>

                    {% else %}

                        <button class="btn btn-outline-secondary btn-sm rounded-3" disabled>

                            Suivant

                            <i class="fas fa-chevron-right ms-1"></i>

                        </button>

                    {% endif %}

                </div>

            {% endif %}

        {% endif %}

    </div>

{% endblock %}
