{% extends 'base.html.twig' %}

{% block title %}Liste des lieux{% endblock %}

{% block body %}

    <div class="container py-4">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h3 class="fw-bold mb-0">
                <i class="fas fa-location-dot me-2 text-primary"></i>
                Lieux
            </h3>

            <div class="d-flex gap-2">

                <a href="{{ path('app_location_create') }}"
                   class="btn btn-outline-primary rounded-pill fw-semibold">

                    <i class="fas fa-plus me-2"></i>
                    Ajouter un lieu

                </a>

                <a href="{{ path('app_city_create') }}"
                   class="btn btn-outline-success rounded-pill fw-semibold">

                    <i class="fas fa-city me-2"></i>
                    Ajouter une ville

                </a>

            </div>

        </div>

        {% if locations is empty %}

            <div class="text-center py-5 text-muted">

                <i class="fas fa-map-location-dot fa-3x mb-3"></i>

                <p class="mb-0">Aucun lieu trouvé</p>

            </div>

        {% else %}

            <div class="row row-cols-1 row-cols-md-3 g-4">

                {% for location in locations %}

                    <div class="col">

                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                            <div class="bg-primary p-3 position-relative">

                            <span class="badge bg-white bg-opacity-25 text-white position-absolute top-0 end-0 m-2 px-3 py-2 rounded-pill">
                                <i class="fas fa-map-pin me-1"></i>
                                {{ location.city.zipcode }}
                            </span>

                                <div class="rounded-circle bg-white bg-opacity-25 d-flex align-items-center justify-content-center"
                                     style="width: 44px; height: 44px;">
                                    <i class="fas fa-location-dot text-white fs-5"></i>
                                </div>

                            </div>

                            <div class="card-body p-4">

                                <h5 class="fw-bold mb-2">
                                    {{ location.name }}
                                </h5>

                                <div class="text-muted small mb-2">
                                    <i class="fas fa-map-marker-alt text-primary me-1"></i>
                                    {{ location.address }}
                                </div>

                                <div class="text-muted small">
                                    <i class="fas fa-city text-primary me-1"></i>
                                    {{ location.city.name }}
                                </div>

                            </div>

                        </div>

                    </div>

                {% endfor %}

            </div>

            {% if totalPages > 1 %}

                <div class="d-flex flex-wrap align-items-center justify-content-center gap-2 mt-4">

                    {% if currentPage > 1 %}
                        <a href="{{ path('app_location_list', { page: currentPage - 1 }) }}"
                           class="btn btn-outline-secondary btn-sm rounded-pill">
                            <i class="fas fa-chevron-left me-1"></i> Précédent
                        </a>
                    {% endif %}

                    {% for p in 1..totalPages %}

                        {% if p == 1 or p == totalPages or (p >= currentPage - 2 and p <= currentPage + 2) %}

                            <a href="{{ path('app_location_list', { page: p }) }}"
                               class="btn btn-sm rounded-pill {{ p == currentPage ? 'btn-primary' : 'btn-outline-secondary' }}">
                                {{ p }}
                            </a>

                        {% endif %}

                    {% endfor %}

                    {% if currentPage < totalPages %}
                        <a href="{{ path('app_location_list', { page: currentPage + 1 }) }}"
                           class="btn btn-outline-secondary btn-sm rounded-pill">
                            Suivant <i class="fas fa-chevron-right ms-1"></i>
                        </a>
                    {% endif %}

                </div>

            {% endif %}

        {% endif %}

    </div>

{% endblock %}
