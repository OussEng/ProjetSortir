{% extends 'base.html.twig' %}

{% block title %}Ajouter un lieu{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                    <div class="bg-primary text-white p-4">

                        <div class="d-flex align-items-center gap-3">

                            <div class="bg-white bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 60px; height: 60px;">

                                <i class="fas fa-location-dot fa-2x"></i>

                            </div>

                            <div>
                                <h2 class="fw-bold mb-1">
                                    Ajouter un lieu
                                </h2>

                                <p class="mb-0 text-white-50">
                                    Créez un nouveau lieu pour les événements
                                </p>
                            </div>

                        </div>

                    </div>

                    <div class="card-body p-4 p-lg-5">

                        {{ form_start(locationForm) }}

                        <div class="mb-4">

                            {{ form_widget(locationForm) }}

                        </div>

                        <div class="d-grid">

                            <button class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm">

                                <i class="fas fa-plus-circle me-2"></i>
                                Ajouter le lieu

                            </button>

                        </div>

                        {{ form_end(locationForm) }}

                    </div>

                </div>

            </div>

        </div>

    </div>

{% endblock %}
